{
  "name": "VisitLog",
  "type": "object",
  "properties": {
    "visitor_key": {
      "type": "string",
      "description": "Hashed visitor fingerprint used to spot repeat visits"
    },
    "day_key": {
      "type": "string",
      "description": "Calendar day in America/New_York, formatted YYYY-MM-DD"
    },
    "ip": {
      "type": "string",
      "description": "IP address the device connected from"
    },
    "path": {
      "type": "string",
      "description": "Page the visitor opened"
    },
    "referrer": {
      "type": "string",
      "description": "Where the visitor arrived from, when known"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the signed-in visitor, when there is one"
    }
  },
  "required": [
    "visitor_key",
    "day_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}